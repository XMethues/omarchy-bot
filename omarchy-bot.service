# omarchy-bot — daemon systemd --user unit
#
# Release artifact. This file ships in-repo; it is NOT installed by the build.
# To run omarchy-bot as a user service (M1+):
#
#   1. Build once (the daemon serves the built web UI on 127.0.0.1:7321):
#        bun install && bun run build
#   2. Install the unit (adjust the repo path if you cloned elsewhere):
#        cp omarchy-bot.service ~/.config/systemd/user/
#        systemctl --user daemon-reload
#   3. Start / enable:
#        systemctl --user start omarchy-bot
#        systemctl --user enable omarchy-bot
#
# The daemon spawns the Agent and computer workers and owns pure-headless Cage
# Bot Screens. It does not inherit or discover a graphical-session Wayland socket.

[Unit]
Description=omarchy-bot daemon (multi-agent bot harness)
Documentation=https://github.com/omarchy-bot/omarchy-bot

[Service]
Type=simple
WorkingDirectory=%h/Projects/omarchy-bot
ExecStart=%h/.local/share/mise/installs/bun/latest/bin/bun run start
Restart=on-failure
RestartSec=3
# Hardened worker supervision: workers are children; keep them in the cgroup.
KillMode=control-group
# Data lives under ~/.local/share/omarchy-bot and ~/.local/state/omarchy-bot.
NoNewPrivileges=true

[Install]
WantedBy=default.target
