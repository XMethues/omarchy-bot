# omarchy-bot — daemon systemd --user unit
#
# Release artifact. This file ships in-repo; it is NOT installed by the build.
# To run omarchy-bot as a user service (M1+):
#
#   1. Build once (the daemon serves the built web UI on 127.0.0.1:7321):
#        bun install && bun run build
#   2. Edit WorkingDirectory and ExecStart below to match this machine
#      (clone path and bun binary). The checked-in values are placeholders.
#   3. Install the unit:
#        cp omarchy-bot.service ~/.config/systemd/user/
#        systemctl --user daemon-reload
#   4. Start / enable from the graphical session so WAYLAND_DISPLAY is inherited:
#        systemctl --user start omarchy-bot
#        systemctl --user enable omarchy-bot
#
# The daemon spawns the pi + computer workers itself. Computer input needs the
# running Wayland session (WAYLAND_DISPLAY is discovered at runtime).

[Unit]
Description=omarchy-bot daemon (local AI teammate workspace)
Documentation=https://github.com/XMethues/omarchy-bot
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/omarchy-bot
ExecStart=%h/.local/share/mise/installs/bun/latest/bin/bun run start
Restart=on-failure
RestartSec=3
# Hardened worker supervision: workers are children; keep them in the cgroup.
KillMode=control-group
# Data lives under ~/.local/share/omarchy-bot and ~/.local/state/omarchy-bot.
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
